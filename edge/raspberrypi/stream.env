# stream.sh 설정 (systemd EnvironmentFile). 미검증 — setup.md 참조
MODE=rtsp                # 노트북이 받는 방식. rtsp: rtsp://<파이IP>:8554/cam | tcp: tcp://<파이IP>:$TCP_PORT (facade-tcp.service)
                         # 어느 모드든 SD 녹화는 카메라 시작부터 연결과 무관하게 계속 (setup.md "녹화 동작")
WIDTH=1920               # 송출 = 녹화 해상도 (인코딩 한 번 — setup.md "알려진 한계")
HEIGHT=1080
FPS=30
BITRATE=6000000          # bps. Wi-Fi 링크가 약하면 낮춘다 (1280x720이면 3000000 정도)
INTRA=30                 # I-프레임 간격 (프레임). 끊겼다 재접속하면 최대 이만큼 뒤에 화면 복구
AF_MODE=continuous       # continuous | manual (유리 반사에 AF가 헤매면 manual)
LENS_POSITION=0.1        # AF_MODE=manual일 때 디옵터 = 1 / 거리(m). 0.1 = 10 m
RTSP_URL=rtsp://127.0.0.1:8554/cam   # 파이 안 MediaMTX publish 주소 (localhost라 Wi-Fi와 무관)
MTX_WAIT_SEC=15         # 시작 시 MediaMTX를 기다리는 최대 시간. 넘으면 녹화만 시작
TCP_PORT=8888
REC_DIR=/home/pi/recordings
SEGMENT_SEC=60           # 녹화 조각 길이. 전원이 갑자기 끊겨도 마지막 조각만 잃는다
